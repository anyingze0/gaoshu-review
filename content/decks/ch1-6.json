  "deck": "ch1-6",
  "cards": [
    {
      "id": "c01",
      "title": "最值定理",
      "tags": [
        "最值定理",
        "闭区间",
        "连续"
      ],
      "summary": "若 $f$ 在闭区间 $[a,b]$ 上连续，则 $f$ 在 $[a,b]$ 上一定能取得最大值和最小值。闭区间与连续两个条件缺一不可。",
      "formulas": [
        {
          "label": "最值定理",
          "tex": "f\\in C[a,b]\\Rightarrow \\exists\\xi,\\eta\\in[a,b],\\ f(\\xi)=\\max_{[a,b]}f,\\ f(\\eta)=\\min_{[a,b]}f"
        }
      ],
      "example": {
        "stem": "说明 $f(x)=\\frac1x$ 在 $(0,1]$ 上为什么不一定能取得最小值。",
        "solution": "$f$ 在 $(0,1]$ 上连续，但区间不是闭区间。当 $x\\to0^+$ 时 $f(x)\\to+\\infty$，所以 $f$ 在 $(0,1]$ 上无最大值，也无最小值。"
      },
      "pitfalls": [
        "开区间上连续函数不一定有最值。",
        "闭区间上不连续也不一定有最值。"
      ],
      "page": 3
    },
    {
      "id": "c02",
      "title": "零点定理",
      "tags": [
        "零点定理",
        "根的存在性",
        "二分法"
      ],
      "summary": "若 $f$ 在 $[a,b]$ 上连续，且 $f(a)f(b)<0$，则至少存在一点 $\\xi\\in(a,b)$，使 $f(\\xi)=0$。几何上，连续曲线从 $x$ 轴一侧穿到另一侧，必与 $x$ 轴相交。",
      "formulas": [
        {
          "label": "零点定理",
          "tex": "f\\in C[a,b],\\ f(a)f(b)<0\\Rightarrow\\exists\\xi\\in(a,b),\\ f(\\xi)=0"
        }
      ],
      "example": {
        "stem": "证明方程 $x^3+x-1=0$ 在 $(0,1)$ 内至少有一个根。",
        "solution": "令 $f(x)=x^3+x-1$，则 $f$ 在 $[0,1]$ 上连续，且 $f(0)=-1<0$，$f(1)=1>0$。由零点定理，存在 $\\xi\\in(0,1)$ 使 $f(\\xi)=0$。"
      },
      "pitfalls": [
        "端点函数值异号是充分条件，不是必要条件。",
        "定理只保证存在性，不保证唯一性。"
      ],
      "page": 4
    },
    {
      "id": "c03",
      "title": "介值定理",
      "tags": [
        "介值定理",
        "中间值",
        "连续性"
      ],
      "summary": "若 $f$ 在 $[a,b]$ 上连续，且 $f(a)\\ne f(b)$，则对介于 $f(a)$ 与 $f(b)$ 之间的任意数 $\\mu$，都存在 $\\xi\\in(a,b)$，使 $f(\\xi)=\\mu$。",
      "formulas": [
        {
          "label": "介值定理",
          "tex": "f\\in C[a,b],\\ \\mu\\text{ 介于 }f(a),f(b)\\text{ 之间}\\Rightarrow\\exists\\xi\\in(a,b),\\ f(\\xi)=\\mu"
        }
      ],
      "example": {
        "stem": "设 $f$ 在 $[0,2]$ 上连续，$f(0)=1$，$f(2)=5$，证明存在 $\\xi\\in(0,2)$ 使 $f(\\xi)=3$。",
        "solution": "$3$ 介于 $1$ 与 $5$ 之间，$f$ 在 $[0,2]$ 上连续，由介值定理，存在 $\\xi\\in(0,2)$ 使 $f(\\xi)=3$。"
      },
      "pitfalls": [
        "介值定理要求函数在闭区间上连续。",
        "结论中的 $\\xi$ 可能在区间内部，也可能在端点（当 $\\mu$ 等于端点值时）。"
      ],
      "page": 10
    },
    {
      "id": "c04",
      "title": "闭区间连续定理的应用",
      "tags": [
        "根的存在性",
        "函数值可达",
        "辅助函数"
      ],
      "summary": "证明方程有根时，常把方程移项构造 $F(x)$，验证 $F$ 连续并找异号端点；证明某个函数值可达时，直接对 $f$ 使用介值定理；证明存在性但不需要具体位置时，优先考虑零点定理或介值定理。",
      "formulas": [
        {
          "label": "辅助函数",
          "tex": "f(x)=g(x)\\iff F(x)=f(x)-g(x)=0"
        }
      ],
      "example": {
        "stem": "设 $f$ 在 $[0,1]$ 上连续，$f(0)=0$，$f(1)=1$。证明存在 $\\xi\\in[0,1]$ 使 $f(\\xi)=\\xi$。",
        "solution": "令 $F(x)=f(x)-x$，则 $F$ 在 $[0,1]$ 上连续，$F(0)=0$，$F(1)=0$。若 $F$ 在端点已为 $0$，结论成立；否则由零点定理（或直接观察）可知存在 $\\xi$ 使 $F(\\xi)=0$，即 $f(\\xi)=\\xi$。"
      },
      "pitfalls": [
        "构造辅助函数后要写清连续性和端点符号。",
        "存在性证明不需要求出具体的 $\\xi$。"
      ],
      "page": 12
    }
  ],
