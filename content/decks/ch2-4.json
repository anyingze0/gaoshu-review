{
  "deck": "ch2-4",
  "cards": [
    {
      "id": "c01",
      "title": "隐函数的求导法",
      "tags": [
        "隐函数",
        "隐函数求导",
        "dy/dx"
      ],
      "summary": "若 $y$ 由方程 $F(x,y)=0$ 确定，求 $\\frac{dy}{dx}$ 时，把 $y$ 看作 $x$ 的函数，对方程两边关于 $x$ 求导，再解出 $y'$。注意对含 $y$ 的项使用链式法则。",
      "formulas": [
        {
          "label": "隐函数",
          "tex": "F(x,y)=0\\Rightarrow \\frac{d}{dx}F(x,y(x))=0"
        },
        {
          "label": "圆方程",
          "tex": "x^2+y^2=R^2\\Rightarrow y'=-\\frac xy"
        }
      ],
      "example": {
        "stem": "已知 $x^2+y^2=25$，求 $\\frac{dy}{dx}$，并求在点 $(3,4)$ 处的值。",
        "solution": "两边对 $x$ 求导：$2x+2yy'=0$，所以 $y'=-\\frac xy$。在 $(3,4)$ 处 $y'=-\\frac34$。"
      },
      "pitfalls": [
        "对 $y^2$ 求导得到 $2yy'$，不要漏掉 $y'$。",
        "求某点导数时，先求导再代入坐标。"
      ],
      "page": 3
    },
    {
      "id": "c02",
      "title": "对数求导法",
      "tags": [
        "对数求导",
        "幂指函数",
        "连乘连除"
      ],
      "summary": "对幂指函数 $y=f(x)^{g(x)}$ 或含大量乘除、乘方的函数，先两边取对数，把幂变成乘积，再两边求导。最后要把 $y$ 乘回去。",
      "formulas": [
        {
          "label": "幂指函数",
          "tex": "y=f(x)^{g(x)}\\Rightarrow y'=y\\left(g'\\ln f+g\\frac{f'}{f}\\right)"
        },
        {
          "label": "取对数",
          "tex": "\\ln y=g(x)\\ln f(x)"
        }
      ],
      "example": {
        "stem": "求 $y=x^x$（$x>0$）的导数。",
        "solution": "两边取对数：$\\ln y=x\\ln x$。求导得 $\\frac{y'}{y}=\\ln x+1$，所以 $y'=x^x(\\ln x+1)$。"
      },
      "pitfalls": [
        "取对数要求函数值为正，必要时加绝对值。",
        "最后不要忘记乘以原函数 $y$。"
      ],
      "page": 6
    },
    {
      "id": "c03",
      "title": "参数方程所确定函数的导数",
      "tags": [
        "参数方程",
        "dy/dx",
        "二阶导数"
      ],
      "summary": "若 $x=\\varphi(t)$、$y=\\psi(t)$，且 $\\varphi'(t)\\ne0$，则 $\\frac{dy}{dx}=\\frac{\\psi'(t)}{\\varphi'(t)}$。求二阶导数时，先对 $t$ 求导，再除以 $\\frac{dx}{dt}$。",
      "formulas": [
        {
          "label": "一阶导数",
          "tex": "\\frac{dy}{dx}=\\frac{dy/dt}{dx/dt}=\\frac{\\psi'(t)}{\\varphi'(t)}"
        },
        {
          "label": "二阶导数",
          "tex": "\\frac{d^2y}{dx^2}=\\frac{\\frac{d}{dt}\\left(\\frac{dy}{dx}\\right)}{\\frac{dx}{dt}}"
        }
      ],
      "example": {
        "stem": "设 $x=t^2$，$y=t^3$，求 $\\frac{dy}{dx}$。",
        "solution": "$\\frac{dx}{dt}=2t$，$\\frac{dy}{dt}=3t^2$，所以 $\\frac{dy}{dx}=\\frac{3t^2}{2t}=\\frac32t$（$t\\ne0$）。"
      },
      "pitfalls": [
        "$\\frac{dy}{dx}$ 仍然是 $t$ 的函数，不是常数。",
        "求二阶导数时不能直接对 $\\frac{dy}{dx}$ 再除以 $\\frac{dx}{dt}$ 之外的东西。"
      ],
      "page": 7
    },
    {
      "id": "c04",
      "title": "相关变化率",
      "tags": [
        "相关变化率",
        "链式法则",
        "实际问题"
      ],
      "summary": "当两个变量 $x(t)$、$y(t)$ 满足某个方程时，对时间 $t$ 求导可得到它们变化率之间的关系。已知一个变化率，就可以求另一个。",
      "formulas": [
        {
          "label": "基本思路",
          "tex": "F(x(t),y(t))=0\\Rightarrow \\frac{dF}{dt}=0"
        },
        {
          "label": "圆面积",
          "tex": "A=\\pi r^2\\Rightarrow \\frac{dA}{dt}=2\\pi r\\frac{dr}{dt}"
        }
      ],
      "example": {
        "stem": "一个气球半径 $r$ 以 $2\\,\\mathrm{cm/s}$ 的速度增大，求半径 $r=5\\,\\mathrm{cm}$ 时体积的增加速率。",
        "solution": "$V=\\frac43\\pi r^3$，$\\frac{dV}{dt}=4\\pi r^2\\frac{dr}{dt}=4\\pi\\cdot25\\cdot2=200\\pi\\,\\mathrm{cm^3/s}$。"
      },
      "pitfalls": [
        "所有变量都应对同一时间 $t$ 求导。",
        "代入数值要在求导之后，避免把变量当常数。"
      ],
      "page": 10
    }
  ],
