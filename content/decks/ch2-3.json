{
  "deck": "ch2-3",
  "cards": [
    {
      "id": "c01",
      "title": "高阶导数的定义与记法",
      "tags": [
        "高阶导数",
        "二阶导数",
        "记法"
      ],
      "summary": "函数 $y=f(x)$ 的导数 $y'$ 仍可能是 $x$ 的函数。对 $y'$ 再求导，得到二阶导数 $y''$；依此类推可得 $n$ 阶导数。二阶导数常记为 $f''(x)$ 或 $\\frac{d^2y}{dx^2}$。",
      "formulas": [
        {
          "label": "二阶导数",
          "tex": "y''=(y')'=\\frac{d^2y}{dx^2}"
        },
        {
          "label": "n 阶导数",
          "tex": "y^{(n)}=(y^{(n-1)})'=\\frac{d^ny}{dx^n}"
        }
      ],
      "example": {
        "stem": "设 $y=x^3$，求 $y''$ 与 $y'''$。",
        "solution": "$y'=3x^2$，$y''=6x$，$y'''=6$。继续求导得 $y^{(4)}=0$。"
      },
      "pitfalls": [
        "$y''$ 表示对 $y$ 连续求导两次，不是 $y$ 的平方。",
        "高阶导数存在的前提是低阶导数存在。"
      ],
      "page": 3
    },
    {
      "id": "c02",
      "title": "常见函数的 n 阶导数",
      "tags": [
        "n阶导数",
        "公式",
        "sin",
        "e^x",
        "ln"
      ],
      "summary": "幂函数、指数函数、正弦余弦函数、对数函数和分式函数都有固定的 $n$ 阶导数公式。记住这些公式，可以避免每次从头逐阶求导。",
      "formulas": [
        {
          "label": "幂函数",
          "tex": "(x^\\mu)^{(n)}=\\mu(\\mu-1)\\cdots(\\mu-n+1)x^{\\mu-n}"
        },
        {
          "label": "指数函数",
          "tex": "(e^{ax})^{(n)}=a^ne^{ax}"
        },
        {
          "label": "正弦",
          "tex": "(\\sin x)^{(n)}=\\sin\\left(x+\\frac{n\\pi}{2}\\right)"
        },
        {
          "label": "余弦",
          "tex": "(\\cos x)^{(n)}=\\cos\\left(x+\\frac{n\\pi}{2}\\right)"
        },
        {
          "label": "对数",
          "tex": "(\\ln x)^{(n)}=(-1)^{n-1}\\frac{(n-1)!}{x^n}"
        }
      ],
      "example": {
        "stem": "求 $y=\\sin x$ 的 $n$ 阶导数。",
        "solution": "$y'=\\cos x=\\sin(x+\\frac\\pi2)$，$y''=-\\sin x=\\sin(x+\\pi)$，归纳得 $y^{(n)}=\\sin(x+\\frac{n\\pi}{2})$。"
      },
      "pitfalls": [
        "$(\\sin x)^{(n)}$ 的相位是 $x+\\frac{n\\pi}{2}$，不是 $x+n\\pi$。",
        "对数函数的 $n$ 阶导数有符号因子 $(-1)^{n-1}$。"
      ],
      "page": 11
    },
    {
      "id": "c03",
      "title": "莱布尼茨公式",
      "tags": [
        "莱布尼茨公式",
        "乘积",
        "高阶导数"
      ],
      "summary": "求两个函数乘积的 $n$ 阶导数时，使用莱布尼茨公式，其结构与二项式展开类似。当其中一个因子是低次多项式时，只有前几项非零，计算会大大简化。",
      "formulas": [
        {
          "label": "莱布尼茨公式",
          "tex": "(uv)^{(n)}=\\sum_{k=0}^{n}\\binom{n}{k}u^{(k)}v^{(n-k)}"
        }
      ],
      "example": {
        "stem": "设 $y=x^2e^{2x}$，求 $y^{(20)}$ 中 $x^2$ 项的结构。",
        "solution": "取 $u=x^2$，$v=e^{2x}$。由于 $u^{(k)}=0$（$k\\ge3$），莱布尼茨公式只剩 $k=0,1,2$ 三项：$y^{(20)}=x^2(e^{2x})^{(20)}+20\\cdot2x(e^{2x})^{(19)}+\\binom{20}{2}\\cdot2(e^{2x})^{(18)}$。"
      },
      "pitfalls": [
        "二项式系数是 $\\binom nk$，不要漏掉。",
        "选择求导后很快变为零的因子作为 $u$，可减少项数。"
      ],
      "page": 15
    },
    {
      "id": "c04",
      "title": "用间接法求高阶导数",
      "tags": [
        "间接法",
        "拆项",
        "三角恒等",
        "高阶导数"
      ],
      "summary": "间接法利用已知的高阶导数公式，通过四则运算、变量代换、拆项或三角恒等变形，把复杂函数化为已知形式再求 $n$ 阶导数。",
      "formulas": [
        {
          "label": "拆项",
          "tex": "\\frac1{(x-a)(x-b)}=\\frac1{a-b}\\left(\\frac1{x-a}-\\frac1{x-b}\\right)"
        },
        {
          "label": "降幂",
          "tex": "\\sin^2x=\\frac{1-\\cos2x}{2},\\quad\\cos^2x=\\frac{1+\\cos2x}{2}"
        }
      ],
      "example": {
        "stem": "求 $y=\\frac1{x^2-1}$ 的 $n$ 阶导数。",
        "solution": "$y=\\frac12\\left(\\frac1{x-1}-\\frac1{x+1}\\right)$。利用 $\\left(\\frac1{x-a}\\right)^{(n)}=\\frac{(-1)^nn!}{(x-a)^{n+1}}$，得 $y^{(n)}=\\frac{(-1)^nn!}{2}\\left[\\frac1{(x-1)^{n+1}}-\\frac1{(x+1)^{n+1}}\\right]$。"
      },
      "pitfalls": [
        "拆项时要检查系数是否正确。",
        "三角函数的降幂公式可把高次幂化为低次三角函数的线性组合。"
      ],
      "page": 17
    }
  ],
