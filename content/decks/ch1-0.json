  "cards": [
    {
      "id": "c01",
      "title": "第一章题型与方法总览",
      "tags": [
        "方法总结",
        "极限",
        "连续性",
        "根的存在性"
      ],
      "summary": "第一章的核心题型包括：求定义域与函数表达式、判别初等性质、求数列与函数极限、无穷小比较、讨论连续性、判断间断点类型、确定参数、利用零点定理证明根的存在性。求极限时优先考虑四则运算、等价无穷小、两个重要极限、夹逼定理和单调有界原理。",
      "formulas": [
        {
          "label": "等价替换",
          "tex": "\\sin x\\sim x,\\quad 1-\\cos x\\sim\\frac{x^2}{2},\\quad \\ln(1+x)\\sim x"
        },
        {
          "label": "重要极限",
          "tex": "\\lim_{x\\to0}\\frac{\\sin x}{x}=1,\\quad \\lim_{x\\to\\infty}\\left(1+\\frac1x\\right)^x=e"
        }
      ],
      "example": {
        "stem": "求 $\\lim_{x\\to0}\\frac{1-\\cos2x}{x^2}$。",
        "solution": "利用 $1-\\cos u\\sim\\frac{u^2}{2}$，令 $u=2x$，得 $1-\\cos2x\\sim\\frac{(2x)^2}{2}=2x^2$，所以极限为 $2$。"
      },
      "pitfalls": [
        "先判断类型（$\\frac00$、$\\frac\\infty\\infty$、$1^\\infty$），再选方法。",
        "等价无穷小替换只适用于乘除因子。"
      ],
      "page": 2
    }
  ],
  "questions": [
    {
      "id": "q001",
      "type": "single",
      "difficulty": 2,
      "stem": "$\\lim_{x\\to0}\\frac{1-\\cos2x}{x^2}=$（ ）",
      "options": [
        [
          "A",
          "$0$"
        ],
        [
          "B",
          "$1$"
        ],
        [
          "C",
          "$2$"
        ],
        [
          "D",
          "$4$"
        ]
      ],
      "answer": [
        "C"
      ],
      "explanation": "$1-\\cos2x\\sim\\frac{(2x)^2}{2}=2x^2$，所以极限为 $2$。",
      "page": 6,
      "kp": "c01"
    },
    {
      "id": "q002",
      "type": "single",
      "difficulty": 2,
      "stem": "$\\lim_{x\\to+\\infty}(\\sqrt{x^2+x}-x)=$（ ）",
      "options": [
        [
          "A",
          "$0$"
        ],
        [
          "B",
          "$\\frac12$"
        ],
        [
          "C",
          "$1$"
        ],
        [
          "D",
          "$+\\infty$"
        ]
      ],
      "answer": [
        "B"
      ],
      "explanation": "有理化：$\\sqrt{x^2+x}-x=\\frac{x}{\\sqrt{x^2+x}+x}=\\frac1{\\sqrt{1+1/x}+1}\\to\\frac12$。",
      "page": 9,
      "kp": "c01"
    },
    {
      "id": "q003",
      "type": "fill",
      "difficulty": 1,
      "stem": "$\\lim_{x\\to0}\\frac{e^{2x}-1}{x}=$（　）。",
      "options": [],
      "answer": [
        [
          "2"
        ]
      ],
      "explanation": "$e^{2x}-1\\sim2x$，所以极限为 $2$。",
      "page": 6,
      "kp": "c01"
    },
    {
      "id": "q004",
      "type": "single",
      "difficulty": 1,
      "stem": "$f(x)=\\frac{x^2-1}{x-1}$ 在 $x=1$ 处的间断点类型是（ ）",
      "options": [
        [
          "A",
          "可去间断点"
        ],
        [
          "B",
          "跳跃间断点"
        ],
        [
          "C",
          "无穷间断点"
        ],
        [
          "D",
          "振荡间断点"
        ]
      ],
      "answer": [
        "A"
      ],
      "explanation": "$\\lim_{x\\to1}f(x)=\\lim_{x\\to1}(x+1)=2$，但 $f(1)$ 无定义，所以是可去间断点。",
      "page": 15,
      "kp": "c01"
    },
    {
      "id": "q005",
      "type": "single",
      "difficulty": 1,
      "stem": "$\\lim_{x\\to0}(1+x)^{1/x}=$（ ）",
