    },
    {
      "id": "q009",
      "type": "multi",
      "difficulty": 1,
      "stem": "求下列极限时，适合使用重要极限 $\\lim_{t\\to0}(1+t)^{1/t}=e$ 的是（多选）",
      "options": [
        [
          "A",
          "$\\lim_{n\\to\\infty}(1+1/n)^n$"
        ],
        [
          "B",
          "$\\lim_{x\\to0}(1+x)^{1/x}$"
        ],
        [
          "C",
          "$\\lim_{x\\to0}\\frac{\\sin x}{x}$"
        ],
        [
          "D",
          "$\\lim_{n\\to\\infty}(1-1/n)^n$"
        ]
      ],
      "answer": [
        "A",
        "B",
        "D"
      ],
      "explanation": "A、B 是重要极限 $e$ 的标准形式；D 可写成 $(1+(-1/n))^n$，极限为 $e^{-1}$，仍属于该重要极限的变形。C 使用的是 $\\lim_{x\\to0}\\frac{\\sin x}{x}=1$，不是 $e$ 型极限。",
      "page": 3,
      "kp": "c01"
    }
