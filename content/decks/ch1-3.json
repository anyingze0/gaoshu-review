      "name": "左右极限",
      "tex": "\\lim_{x\\to x_0}f(x)=A\\iff f(x_0^-)=f(x_0^+)=A",
      "note": "判断分段函数在分界点处的极限",
      "page": 12
    },
    {
      "id": "f04",
      "group": "函数极限",
      "name": "第一重要极限",
      "tex": "\\lim_{x\\to0}\\frac{\\sin x}{x}=1",
      "note": "$x$ 必须趋于 $0$",
      "page": 41
    },
    {
      "id": "f05",
      "group": "函数极限",
