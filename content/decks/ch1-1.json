{
  "deck": "ch1-1",
  "cards": [
    {
      "id": "c01",
      "title": "集合、区间与邻域",
      "tags": [
        "集合",
        "区间",
        "邻域"
      ],
      "summary": "集合是具有某种特定性质的对象的全体，常用枚举法或描述法表示。区间和邻域是后续讨论极限的基本工具。",
      "formulas": [
        {
          "label": "开区间",
          "tex": "(a,b)=\\{x\\mid a<x<b\\}"
        },
        {
          "label": "邻域",
          "tex": "U(x_0,\\delta)=(x_0-\\delta,x_0+\\delta)"
        },
        {
          "label": "去心邻域",
          "tex": "\\mathring{U}(x_0,\\delta)=\\{x\\mid 0<|x-x_0|<\\delta\\}"
        }
      ],
      "example": {
        "stem": "用区间表示集合 $A=\\{x\\mid |x-1|<2\\}$。",
        "solution": "$|x-1|<2\\iff -2<x-1<2\\iff -1<x<3$，所以 $A=(-1,3)$。"
      },
      "pitfalls": [
        "邻域是开区间，端点不包含。",
        "空集是任何集合的子集，讨论子集时不要漏掉空集。"
      ],
      "page": 9
    },
    {
      "id": "c02",
      "title": "函数的概念与两要素",
      "tags": [
        "函数",
        "定义域",
        "对应法则"
      ],
      "summary": "函数是定义域到值域的对应法则。判断两个函数是否相同，只看定义域与对应法则，与自变量用什么字母无关。",
      "formulas": [
        {
          "label": "函数记号",
          "tex": "y=f(x),\\quad x\\in D"
        }
      ],
      "example": {
        "stem": "判断 $f(x)=\\ln x^2$ 与 $g(x)=2\\ln x$ 是否表示同一个函数。",
        "solution": "$f$ 的定义域为 $x\\ne0$，$g$ 的定义域为 $x>0$。定义域不同，所以不是同一个函数。"
      },
      "pitfalls": [
        "定义域不同，函数一定不同。",
        "先看定义域，再谈化简后的表达式。"
      ],
      "page": 12
    },
    {
      "id": "c03",
      "title": "几类特殊函数",
      "tags": [
        "绝对值函数",
        "取整函数",
        "分段函数"
      ],
      "summary": "常见特殊函数包括绝对值函数、符号函数、取整函数、狄利克雷函数、取最值函数和分段函数。分段函数在分界点处要单独讨论。",
      "formulas": [
        {
          "label": "绝对值",
          "tex": "|x|=\\begin{cases}x,&x\\ge0\\\\-x,&x<0\\end{cases}"
        },
        {
          "label": "取整函数",
          "tex": "[x]\\le x<[x]+1"
        }
      ],
      "example": {
        "stem": "计算 $[2.9]$ 与 $[-0.3]$。",
        "solution": "$[x]$ 表示不超过 $x$ 的最大整数，所以 $[2.9]=2$，$[-0.3]=-1$。"
      },
      "pitfalls": [
        "负数取整不是直接去掉小数部分。",
        "分段函数在分界点处必须分别看左右两侧。"
      ],
      "page": 14
    },
    {
      "id": "c04",
      "title": "函数的有界性",
      "tags": [
        "有界性",
        "上界",
        "下界"
      ],
      "summary": "若存在正数 $M$，使对一切 $x\\in D$ 都有 $|f(x)|\\le M$，则称 $f$ 在 $D$ 上有界；否则称为无界。",
      "formulas": [
        {
          "label": "有界定义",
          "tex": "\\exists M>0,\\ \\forall x\\in D,\\ |f(x)|\\le M"
        }
      ],
      "example": {
        "stem": "判断 $f(x)=\\frac1x$ 在 $(0,1)$ 上是否有界。",
        "solution": "无界。对任意 $M>0$，取 $x=\\frac1{2M}\\in(0,1)$，则 $f(x)=2M>M$。"
      },
      "pitfalls": [
        "有界性与区间有关。$\\frac1x$ 在 $(1,+\\infty)$ 上有界。",
        "局部有界不等于在整个定义域上有界。"
      ],
      "page": 18
    },
    {
      "id": "c05",
      "title": "单调性、奇偶性与周期性",
      "tags": [
        "单调性",
        "奇偶性",
        "周期性"
      ],
      "summary": "单调性描述函数的增减趋势；奇偶性要求定义域关于原点对称；周期性描述函数值重复出现的规律。",
      "formulas": [
        {
          "label": "奇函数",
          "tex": "f(-x)=-f(x)"
        },
        {
          "label": "偶函数",
          "tex": "f(-x)=f(x)"
        },
        {
          "label": "周期",
          "tex": "f(x+T)=f(x)"
        }
      ],
      "example": {
        "stem": "判断 $f(x)=x^3$ 的奇偶性，并写出 $\\sin x$ 的一个周期。",
        "solution": "$f(-x)=(-x)^3=-x^3=-f(x)$，故 $f$ 为奇函数；$\\sin(x+2\\pi)=\\sin x$，所以 $2\\pi$ 是一个周期。"
      },
      "pitfalls": [
        "定义域不关于原点对称时，函数既不是奇函数也不是偶函数。",
        "周期函数不一定有最小正周期。"
      ],
      "page": 21
    },
    {
      "id": "c06",
      "title": "复合运算与反函数",
      "tags": [
        "复合函数",
        "反函数",
        "单调"
      ],
      "summary": "复合函数要求内层函数的值域落在外层函数的定义域内；严格单调函数一定存在反函数，且反函数的定义域是原函数的值域。",
      "formulas": [
        {
          "label": "复合函数",
          "tex": "(f\\circ g)(x)=f(g(x))"
        },
        {
          "label": "反函数",
          "tex": "y=f(x)\\iff x=f^{-1}(y)"
        }
      ],
      "example": {
        "stem": "设 $f(x)=2x+1$，求 $f^{-1}(x)$。",
        "solution": "由 $y=2x+1$ 解出 $x=\\frac{y-1}{2}$，交换字母得 $f^{-1}(x)=\\frac{x-1}{2}$。"
      },
      "pitfalls": [
        "复合函数存在，不代表定义域一定是全体实数。",
        "求反函数前先判断原函数是否严格单调。"
      ],
      "page": 31
    },
    {
      "id": "c07",
      "title": "基本初等函数与初等函数",
      "tags": [
        "基本初等函数",
        "初等函数",
        "定义域"
      ],
      "summary": "基本初等函数包括常函数、幂函数、指数函数、对数函数、三角函数和反三角函数。由它们经过有限次四则运算和复合得到的函数称为初等函数。",
      "formulas": [
        {
          "label": "指数函数",
          "tex": "y=a^x\\quad(a>0,\\ a\\ne1)"
        },
        {
          "label": "对数函数",
          "tex": "y=\\log_a x\\quad(a>0,\\ a\\ne1,\\ x>0)"
        }
      ],
      "example": {
        "stem": "求 $y=\\ln(1-x)$ 的定义域。",
        "solution": "需 $1-x>0$，即 $x<1$，所以定义域为 $(-\\infty,1)$。"
      },
      "pitfalls": [
        "初等函数在其定义区间内连续。",
        "幂函数 $x^\\mu$ 的定义域随 $\\mu$ 的取值而变化。"
      ],
      "page": 39
    }
  ],
