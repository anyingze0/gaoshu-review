{
  "deck": "ch2-2",
  "cards": [
    {
      "id": "c01",
      "title": "导数的四则运算",
      "tags": [
        "四则运算",
        "乘积法则",
        "商法则"
      ],
      "summary": "可导函数的和、差、积、商（分母不为零）仍可导。乘积法则是“前导后不导加前不导后导”，商法则是“分子求导乘分母减分子乘分母求导，再除以分母平方”。",
      "formulas": [
        {
          "label": "和差",
          "tex": "(u\\pm v)'=u'\\pm v'"
        },
        {
          "label": "乘积",
          "tex": "(uv)'=u'v+uv'"
        },
        {
          "label": "商",
          "tex": "\\left(\\frac uv\\right)'=\\frac{u'v-uv'}{v^2}\\quad(v\\ne0)"
        }
      ],
      "example": {
        "stem": "求 $y=x^3-2x^2+\\sin x$ 的导数。",
        "solution": "$y'=(x^3)'-2(x^2)'+(\\sin x)'=3x^2-4x+\\cos x$。"
      },
      "pitfalls": [
        "$(uv)'\\ne u'v'$。",
        "商法则分子中的两项顺序不能颠倒。"
      ],
      "page": 3
    },
    {
      "id": "c02",
      "title": "反函数的导数",
      "tags": [
        "反函数",
        "反函数求导",
        "arcsin",
        "arctan"
      ],
      "summary": "若 $x=\\varphi(y)$ 在区间内单调、可导且 $\\varphi'(y)\\ne0$，则其反函数 $y=f(x)$ 可导，且 $f'(x)=\\frac1{\\varphi'(y)}$。由此可推出反三角函数和对数函数的导数。",
      "formulas": [
        {
          "label": "反函数求导",
          "tex": "\\frac{dy}{dx}=\\frac1{\\frac{dx}{dy}}\\quad\\left(\\frac{dx}{dy}\\ne0\\right)"
        },
        {
          "label": "反正弦",
          "tex": "(\\arcsin x)'=\\frac1{\\sqrt{1-x^2}}"
        },
        {
          "label": "反正切",
          "tex": "(\\arctan x)'=\\frac1{1+x^2}"
        }
      ],
      "example": {
        "stem": "求 $y=\\arctan x$ 的导数。",
        "solution": "由 $x=\\tan y$，$\\frac{dx}{dy}=\\sec^2y=1+\\tan^2y=1+x^2$，所以 $y'=\\frac1{1+x^2}$。"
      },
      "pitfalls": [
        "反函数求导的结果要换回原自变量 $x$。",
        "条件 $\\varphi'(y)\\ne0$ 不能忽略。"
      ],
      "page": 7
    },
    {
      "id": "c03",
      "title": "复合函数的链式法则",
      "tags": [
        "复合函数",
        "链式法则",
        "求导"
      ],
      "summary": "若 $y=f(u)$ 在 $u$ 处可导，$u=g(x)$ 在 $x$ 处可导，则复合函数 $y=f(g(x))$ 可导，且 $\\frac{dy}{dx}=f'(u)g'(x)$。关键是分清复合层次，由外向内逐层求导。",
      "formulas": [
        {
          "label": "链式法则",
          "tex": "\\frac{dy}{dx}=\\frac{dy}{du}\\cdot\\frac{du}{dx}"
        },
        {
          "label": "多层复合",
          "tex": "\\frac{dy}{dx}=f'(u)g'(v)h'(x)\\quad(y=f(g(h(x))))"
        }
      ],
      "example": {
        "stem": "求 $y=\\sin 2x$ 的导数。",
        "solution": "设 $u=2x$，则 $y=\\sin u$，$y'=\\cos u\\cdot2=2\\cos2x$。"
      },
      "pitfalls": [
        "不要漏乘内层函数的导数。",
        "复合层次越多，越要逐层写清楚。"
      ],
      "page": 11
    },
    {
      "id": "c04",
      "title": "基本初等函数导数公式表",
      "tags": [
        "导数公式",
        "基本初等函数",
        "公式表"
      ],
      "summary": "熟练掌握基本初等函数的导数公式，是进行四则运算、复合运算和隐函数求导的基础。特别要注意 $\\ln x$ 与 $\\log_a x$、$\\tan x$ 与 $\\cot x$ 的符号和系数差异。",
      "formulas": [
        {
          "label": "幂函数",
          "tex": "(x^\\mu)'=\\mu x^{\\mu-1}"
        },
        {
          "label": "指数函数",
          "tex": "(a^x)'=a^x\\ln a,\\quad(e^x)'=e^x"
        },
        {
          "label": "对数函数",
          "tex": "(\\log_a x)'=\\frac1{x\\ln a},\\quad(\\ln x)'=\\frac1x"
        },
        {
          "label": "三角函数",
          "tex": "(\\sin x)'=\\cos x,\\quad(\\cos x)'=-\\sin x"
        },
        {
          "label": "正切余切",
          "tex": "(\\tan x)'=\\sec^2x,\\quad(\\cot x)'=-\\csc^2x"
        },
        {
          "label": "反三角",
          "tex": "(\\arcsin x)'=\\frac1{\\sqrt{1-x^2}},\\quad(\\arctan x)'=\\frac1{1+x^2}"
        }
      ],
      "example": {
        "stem": "求 $y=\\ln x+2^x$ 的导数。",
        "solution": "$y'=\\frac1x+2^x\\ln2$。"
      },
      "pitfalls": [
        "$(\\cos x)'=-\\sin x$，负号不能漏。",
        "$(\\log_a x)'$ 的分母有 $\\ln a$。"
      ],
      "page": 17
    },
    {
      "id": "c05",
      "title": "初等函数求导综合",
      "tags": [
        "综合求导",
        "四则运算",
        "复合函数"
      ],
      "summary": "初等函数求导时，先观察结构：是四则运算还是复合运算；再按“由外向内、逐层求导”的顺序处理。必要时先化简（如对数性质、三角恒等式），可以显著减少计算量。",
      "formulas": [
        {
          "label": "对数化简",
          "tex": "\\ln\\frac{u}{v}=\\ln u-\\ln v"
        },
        {
          "label": "三角恒等",
          "tex": "\\sin2x=2\\sin x\\cos x"
        }
      ],
      "example": {
        "stem": "求 $y=\\ln(x+\\sqrt{1+x^2})$ 的导数。",
        "solution": "$y'=\\frac1{x+\\sqrt{1+x^2}}\\left(1+\\frac{x}{\\sqrt{1+x^2}}\\right)=\\frac1{\\sqrt{1+x^2}}$。"
      },
      "pitfalls": [
        "先化简再求导，往往比直接硬算更简单。",
        "复合函数求导后要检查是否还能化简。"
      ],
      "page": 18
    }
  ],
