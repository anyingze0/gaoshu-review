{
  "deck": "ch1-2",
  "cards": [
    {
      "id": "c01",
      "title": "数列极限的 ε-N 定义",
      "tags": [
        "数列极限",
        "ε-N",
        "极限定义"
      ],
      "summary": "设 $\\{a_n\\}$ 为数列，$a$ 为常数。若对任意 $\\varepsilon>0$，总存在正整数 $N$，当 $n>N$ 时都有 $|a_n-a|<\\varepsilon$，则称数列收敛于 $a$，记作 $\\lim_{n\\to\\infty}a_n=a$。",
      "formulas": [
        {
          "label": "ε-N 定义",
          "tex": "\\lim_{n\\to\\infty}a_n=a\\iff \\forall\\varepsilon>0,\\ \\exists N\\in\\mathbb{N},\\ n>N\\Rightarrow |a_n-a|<\\varepsilon"
        }
      ],
      "example": {
        "stem": "用定义证明 $\\lim_{n\\to\\infty}\\frac1n=0$。",
        "solution": "任给 $\\varepsilon>0$，要使 $\\left|\\frac1n-0\\right|=\\frac1n<\\varepsilon$，只需 $n>\\frac1\\varepsilon$。取 $N=\\left[\\frac1\\varepsilon\\right]+1$，则当 $n>N$ 时恒有 $\\left|\\frac1n\\right|<\\varepsilon$，故极限为 $0$。"
      },
      "pitfalls": [
        "$N$ 依赖于 $\\varepsilon$，但不能依赖于 $n$。",
        "改变数列的有限项不影响其极限。"
      ],
      "page": 5
    },
    {
      "id": "c02",
      "title": "用定义验证数列极限",
      "tags": [
        "ε-N",
        "证明",
        "放缩"
      ],
      "summary": "证明 $\\lim a_n=a$ 的固定套路：任给 $\\varepsilon>0$，计算 $|a_n-a|$，通过放缩把它化为只含 $n$ 的简单表达式，再解出 $n>N(\\varepsilon)$。",
      "formulas": [
        {
          "label": "目标不等式",
          "tex": "|a_n-a|<\\varepsilon\\quad(n>N)"
        }
      ],
      "example": {
        "stem": "证明 $\\lim_{n\\to\\infty}\\frac{2n+1}{n+1}=2$。",
        "solution": "$\\left|\\frac{2n+1}{n+1}-2\\right|=\\left|\\frac{-1}{n+1}\\right|=\\frac1{n+1}<\\varepsilon$，只需 $n>\\frac1\\varepsilon-1$。取 $N=\\left[\\frac1\\varepsilon\\right]+1$ 即可。"
      },
      "pitfalls": [
        "放缩必须保持不等式方向正确。",
        "$N$ 取整数时通常写成取整加一，确保 $n>N$。"
      ],
      "page": 10
    },
    {
      "id": "c03",
      "title": "收敛数列的基本性质",
      "tags": [
        "唯一性",
        "有界性",
        "子列",
        "保号性"
      ],
      "summary": "收敛数列的极限唯一；收敛数列必有界；若极限为正（负），则从某一项起数列保持为正（负）；收敛数列的任意子列都收敛于同一极限。",
      "formulas": [
        {
          "label": "收敛必有界",
          "tex": "a_n\\to a\\Rightarrow \\exists M>0,\\ |a_n|\\le M"
        },
        {
          "label": "子列性质",
          "tex": "a_n\\to a\\Rightarrow a_{n_k}\\to a"
        }
      ],
      "example": {
        "stem": "说明 $a_n=(-1)^n$ 为什么发散。",
        "solution": "取子列 $a_{2n}=1\\to1$，$a_{2n-1}=-1\\to-1$。两个子列极限不同，而收敛数列的所有子列必须收敛于同一极限，所以原数列发散。",
        "note": "有界但发散"
      },
      "pitfalls": [
        "有界只是收敛的必要条件，不是充分条件。",
        "只要找到两个极限不同的子列，就能判定原数列发散。"
      ],
      "page": 18
    },
    {
      "id": "c04",
      "title": "极限四则运算与夹逼定理",
      "tags": [
        "四则运算",
        "夹逼定理",
        "迫敛性"
      ],
      "summary": "若 $\\lim a_n=A$、$\\lim b_n=B$，则和、差、积、商的极限分别为 $A\\pm B$、$AB$、$A/B$（要求 $B\\ne0$）。夹逼定理常用于和式或含 $\\sin$、$(-1)^n$ 的数列。",
      "formulas": [
        {
          "label": "四则运算",
          "tex": "\\lim(a_n\\pm b_n)=A\\pm B,\\quad \\lim(a_nb_n)=AB,\\quad \\lim\\frac{a_n}{b_n}=\\frac AB\\ (B\\ne0)"
        },
        {
          "label": "夹逼定理",
          "tex": "b_n\\le a_n\\le c_n,\\quad b_n\\to L,\\ c_n\\to L\\Rightarrow a_n\\to L"
        }
      ],
      "example": {
        "stem": "求 $\\lim_{n\\to\\infty}\\left(\\frac1{n^2}+\\frac2{n^2}+\\cdots+\\frac n{n^2}\\right)$。",
        "solution": "原式 $=\\lim_{n\\to\\infty}\\frac{1+2+\\cdots+n}{n^2}=\\lim_{n\\to\\infty}\\frac{n(n+1)}{2n^2}=\\frac12$。"
      },
      "pitfalls": [
        "商的法则要求分母极限不为零。",
        "夹逼定理必须保证左右两边的极限相同。"
      ],
      "page": 25
    },
    {
      "id": "c05",
      "title": "重要极限与自然常数 e",
      "tags": [
        "重要极限",
        "e",
        "1的无穷次方"
      ],
      "summary": "数列 $\\left(1+\\frac1n\\right)^n$ 单调递增且有上界，因此收敛，其极限记为 $e$。由此可推广出一批 $1^\\infty$ 型极限。",
      "formulas": [
        {
          "label": "e 的定义",
          "tex": "\\lim_{n\\to\\infty}\\left(1+\\frac1n\\right)^n=e"
        },
        {
          "label": "推广",
          "tex": "\\lim_{n\\to\\infty}\\left(1+\\frac{k}{n}\\right)^n=e^k"
        }
      ],
      "example": {
        "stem": "求 $\\lim_{n\\to\\infty}\\left(1-\\frac1n\\right)^n$。",
        "solution": "$\\left(1-\\frac1n\\right)^n=\\left(1+\\frac{-1}{n}\\right)^n\\to e^{-1}=\\frac1e$。"
      },
      "pitfalls": [
        "$1^\\infty$ 是未定式，不能直接把底数当成 $1$。",
        "先化成标准形式 $(1+u_n)^{1/u_n}$，其中 $u_n\\to0$。"
      ],
      "page": 33
    },
    {
      "id": "c06",
      "title": "单调有界原理",
      "tags": [
        "单调有界",
        "递推数列",
        "存在性"
      ],
      "summary": "单调递增且有上界的数列必收敛；单调递减且有下界的数列必收敛。递推数列常先用归纳法证明单调和有界，再对递推式两边取极限。",
      "formulas": [
        {
          "label": "单调有界原理",
          "tex": "\\{a_n\\}\\text{ 单调递增且有上界}\\Rightarrow \\{a_n\\}\\text{ 收敛}"
        }
      ],
      "example": {
        "stem": "设 $x_1=\\sqrt2$，$x_{n+1}=\\sqrt{2+x_n}$，证明极限存在并求极限。",
        "solution": "可归纳证明 $0<x_n<2$ 且 $x_{n+1}>x_n$，故极限存在。设极限为 $L$，对 $x_{n+1}=\\sqrt{2+x_n}$ 取极限得 $L=\\sqrt{2+L}$，即 $L^2-L-2=0$，结合 $L>0$ 得 $L=2$。"
      },
      "pitfalls": [
        "必须先证明极限存在，才能对递推式两边取极限。",
        "单调递增还需要有上界，二者缺一不可。"
      ],
      "page": 39
    }
  ],
